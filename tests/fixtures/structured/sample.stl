# --- Intent ---
[Project:Widget] -> [Goal:ShipReader] ::mod(
  rule="definitional", confidence=0.95,
  description="A local, read-only reader for generated documents, with no account and no sync.",
  source="design/overview.md")

# --- Dependency graph (source enables target) ---
[Sub1:Parser]   -> [Sub3:Viewer]  ::mod(rule="logical", confidence=0.95, description="the viewer renders what the parser produced")
[Sub2:Registry] -> [Sub3:Viewer]  ::mod(rule="logical", confidence=0.9)
[Sub3:Viewer]   -> [Sub4:Printing] ::mod(rule="logical", confidence=0.8, description="print reuses the rendered document")

# --- Risks ---
[Risk:LargeDocuments] -> [Mitigation:RowCap] ::mod(rule="causal", confidence=0.7, description="cap tabular views and say how many rows were left out")

